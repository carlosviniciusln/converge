{
  "globalHeaders": {
    "Cache-Control": "no-cache, must-revalidate"
  },
  "routes": [
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/*.css",
      "/*.scss",
      "/*.js",
      "/*.png",
      "/*.gif",
      "/*.ico",
      "/*.jpg",
      "/*.svg",
      "/*.woff",
      "/*.woff2",
      "/*.ttf",
      "/*.eot"
    ]
  }
}
