/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "paths": {
      "sidsc-components/dsc-header": ["sidsc-stubs/dsc-header/index.ts"],
      "sidsc-components/dsc-sidenav": ["sidsc-stubs/dsc-sidenav/index.ts"],
      "sidsc-components/dsc-button-header": ["sidsc-stubs/dsc-button-header/index.ts"],
      "sidsc-components/dsc-progress-spinner": ["sidsc-stubs/dsc-progress-spinner/index.ts"],
      "sidsc-components/dsc-button": ["sidsc-stubs/dsc-button/index.ts"],
      "sidsc-components/dsc-breadcrumb": ["sidsc-stubs/dsc-breadcrumb/index.ts"],
      "sidsc-components/dsc-checkbox": ["sidsc-stubs/dsc-checkbox/index.ts"],
      "sidsc-components/dsc-select": ["sidsc-stubs/dsc-select/index.ts"],
      "sidsc-components/dsc-select/shared/option": ["sidsc-stubs/dsc-select/shared/option/index.ts"],
      "sidsc-components/dsc-footer": ["sidsc-stubs/dsc-footer/index.ts"],
      "sidsc-components/dsc-paginator": ["sidsc-stubs/dsc-paginator/index.ts"],
      "sidsc-components/dsc-snackbar": ["sidsc-stubs/dsc-snackbar/index.ts"],
      "sidsc-components/dsc-accordion": ["sidsc-stubs/dsc-accordion/index.ts"],
      "sidsc-components/dsc-alert": ["sidsc-stubs/dsc-alert/index.ts"],
      "sidsc-components/dsc-card": ["sidsc-stubs/dsc-card/index.ts"],
      "sidsc-components/dsc-input": ["sidsc-stubs/dsc-input/index.ts"],
      "sidsc-components/dsc-tags": ["sidsc-stubs/dsc-tags/index.ts"],
      "sidsc-components/dsc-progress-bar": ["sidsc-stubs/dsc-progress-bar/index.ts"],
      "sidsc-components/dsc-chips": ["sidsc-stubs/dsc-chips/index.ts"]
    },
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declaration": false,
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "target": "ES2022",
    "module": "es2020",
    "lib": [
      "es2018",
      "dom"
    ],
    "useDefineForClassFields": false
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
